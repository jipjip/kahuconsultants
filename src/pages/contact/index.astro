---
import Hero from '@components/Hero.astro';
import Layout from '@layouts/Layout.astro';
import Quote from '@components/Quote.astro';
import ContactForm from '@components/navigation/layouts/ContactForm.astro';
import ContactInfo from '@components/ContactInfo.astro'; 
---

<Layout 
  pageName="Contact us"
  pageDescription="Tell us about your sustainability objectives and we will be in touch to discuss how Kahu Consultants can help you achieve them."
  type="article">
	<Hero 
    title = "Let's start a conversation.",
    description = "Tell us about your sustainability objectives and we will be in touch to discuss how Kahu Consultants can help you achieve them.",
    heroType = "contact abstr1"
  />

  <section>
    <div class="cntr">
      <h2>We'd love to hear from you.</h2>
      <p>Whether you have a specific brief in mind or simply want to explore what support might look like, we welcome the conversation. All initial enquiries are handled directly by our advisory team.</p>
    </div>
  </section>

     <ContactForm
      formTitle = "Enquiry Form"
      formDescription = "Fill in the form below and a member of our team will be in touch shortly."
      inputFirstName = {{
        label: "First Name",
        placeholder: "Jane"
      }}
      inputLastName = {{
        label: "Last Name",
        placeholder: "Smith"
      }}
      companyName = {{
        label: "Company",
        placeholder: "Your organisation"
      }}
      emailAddress = {{
        label: "Email Address",
        placeholder: "jane@company.com"
      }}
      services = {{
        label: "Service of Interest",
        default: "Select a service...",
        list: [
          {
            name: "EcoVadis Advisory",
            value: "ecovadis"
          },{
            name: "CDP Disclosure Support",
            value: "cdp"
          },{
            name: "ESG Reporting",
            value: "esgreporting"
          },{
            name: "ESG Strategy",
            value: "esgstrategy"
          },{
            name: "Multiple Services / Not Sure Yet",
            value: "multiplenotsure"
          }
        ]
      }}
      message = {{
        label: "Tell us about your objectives",
        placeholder: "Briefly describe what you're looking to achieve and any relevant context about your organisation..."
      }}
      submitButton = {{
        text: "Send Enquiry",
      }}
      successMessage = {{
        text: "Thank you for your enquiry. We will be in touch within one business day."
      }}
      errorMessage = {{
        text: "Something went wrong sending the form"
      }}
   />

  <Quote 
    quote="Our initial conversations are about understanding your situation — not selling a service. Come with questions." />

  <ContactInfo
    contactInfo={[
      {
        label: "Email",
        text: "hello@kahuconsultants.com"
      },{
        label: "Services",
        text: "EcoVadis · CDP · ESG Reporting · ESG Strategy"
      },{
        label: "Response",
        text: "We aim to respond to all enquiries within one business day."
      },{
        label: "Approach",
        text: "Initial consultations are always complimentary and without obligation."
      }
    ]} />
  
</Layout>
