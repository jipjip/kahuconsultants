---
import Layout from '@layouts/Layout.astro';
---

<Layout
  pageName="Page not found"
  pageDescription="Sorry, we couldn't find the page you were looking for.">
  <section>
    <div class="cntr">
      <h1>Page not found</h1>
      <p>Sorry, we couldn't find the page you were looking for. It may have been moved or no longer exists.</p>
      <a href="/" class="btn --btn-cta">Back to homepage</a>
    </div>
  </section>
</Layout>
