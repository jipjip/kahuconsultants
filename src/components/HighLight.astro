---
import "@styles/HighLight.css";

import MagicContentBox from "./MagicContentBox.astro"
import Picture from "astro/components/Picture.astro";

const { highlightImage, title, eyebrow, contentItems, cta } = Astro.props;

/* HighLight.astro */
---

<section class="--s-highlight">
  <div class="cntr --cntr-g --cntr-13">
    <div class="highlight__body">
      <MagicContentBox
        title={title}
        eyebrow={eyebrow}
        contentItems = {contentItems}
        cta={cta}/>
    </div>
    <div class="highlight__media">
      <div class="cntr --cntr-g --cntr-11">
        <Picture
          src={highlightImage}
          alt="An example image"
          formats={['avif', 'webp']}
          widths={[400, 768, 800]}
          sizes="(max-width: 768px) calc(100vw - 32px), 800px"
        />
      </div>
    </div>
  </div>
</section>