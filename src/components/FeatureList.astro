---
/* Features.astro */
import "@styles/FeatureList.css";
---

<div class="cntr --cntr-g --cntr-11 featurelist">
  { Astro.props.title && 
    <h2 class="as-h3" set:html={Astro.props.title} />
  }
  { Astro.props.features.length > 0 &&
    <ul>
       { Astro.props.features.map((item:any) => (
        <li 
          class="feature"
          set:html={item.feature} />
       ))}
    </ul>
  }
</div>